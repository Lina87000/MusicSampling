    "# --- MIDI export for note_results with auto BPM detection ---\n",
    "\n",
    "# Auto-detect BPM using librosa\n",
    "import librosa\n",
    "y = audio_signal\n",
    "sr = sample_rate\n",
    "tempo_bpm, _ = librosa.beat.beat_track(y=y, sr=sr)\n",
    "if isinstance(tempo_bpm, np.ndarray):\n",
    "    tempo_bpm = float(tempo_bpm[0])\n",
    "tempo_bpm = int(round(tempo_bpm))\n",
    "print(f\"Auto-detected BPM: {tempo_bpm}\")\n",
    "\n",
    "import mido\n",
    "from mido import Message, MidiFile, MidiTrack, bpm2tempo\n",
    "\n",
    "def quantize_duration(duration, tempo_bpm=120):\n",
    "    ticks_per_beat = 480\n",
    "    sec_per_beat = 60.0 / tempo_bpm\n",
    "    note_types = [\n",
    "        (4.0, 'whole'), (2.0, 'half'), (1.0, 'quarter'),\n",
    "        (0.5, 'eighth'), (0.25, '16th')\n",
    "    ]\n",
    "    beats = duration / sec_per_beat\n",
    "    closest = min(note_types, key=lambda x: abs(beats - x[0]))\n",
    "    ticks = int(round(closest[0] * ticks_per_beat))\n",
    "    return ticks\n",
    "\n",
    "def note_name_to_midi(note_name):\n",
    "    note_base = {'C':0, 'C#':1, 'D':2, 'D#':3, 'E':4, 'F':5, 'F#':6, 'G':7, 'G#':8, 'A':9, 'A#':10, 'B':11}\n",
    "    import re\n",
    "    m = re.match(r'^([A-G]#?)(-?\\d+)$', note_name)\n",
    "    if not m:\n",
    "        return 60\n",
    "    name, octave = m.groups()\n",
    "    return 12 + note_base[name] + 12 * int(octave)\n",
    "\n",
    "midi = MidiFile(ticks_per_beat=480)\n",
    "track = MidiTrack()\n",
    "midi.tracks.append(track)\n",
    "\n",
    "track.append(Message('program_change', program=0, time=0))\n",
    "track.append(mido.MetaMessage('set_tempo', tempo=bpm2tempo(tempo_bpm), time=0))\n",
    "\n",
    "sorted_notes = sorted(note_results, key=lambda n: n['start_time'])\n",
    "\n",
    "sec_per_beat = 60.0 / tempo_bpm\n",
    "ticks_per_beat = midi.ticks_per_beat\n",
    "last_start_tick = 0\n",
    "\n",
    "for note in sorted_notes:\n",
    "    midi_num = note_name_to_midi(note['note_name'])\n",
    "    start_tick = int(round(note['start_time'] / sec_per_beat * ticks_per_beat))\n",
    "    duration_ticks = quantize_duration(note['duration'], tempo_bpm=tempo_bpm)\n",
    "    delta = max(0, start_tick - last_start_tick)\n",
    "    track.append(Message('note_on', note=midi_num, velocity=90, time=delta))\n",
    "    track.append(Message('note_off', note=midi_num, velocity=0, time=duration_ticks))\n",
    "    last_start_tick = start_tick + duration_ticks\n",
    "\n",
    "midi.save('detected_notes_export.mid')\n",
    "print(\"MIDI file exported as detected_notes_export.mid\")\n"
   ]
