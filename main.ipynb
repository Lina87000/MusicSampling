    "# Use the correct return structure from detect_notes_with_envelope_analysis\n",
    "note_data = detect_notes_with_envelope_analysis(y, sr)\n",
    "# Extract MIDI numbers and start times for plotting and MIDI export\n",
    "detected_notes = [n['midi_number'] if 'midi_number' in n else 60 for n in note_data['notes']]\n",
    "timestamps = [n['start_time'] for n in note_data['notes']]\n",
