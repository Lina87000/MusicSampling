    "# Fourier Transform Analysis of Each Detected Note\n",
    "def analyze_note_fft(audio_signal, sample_rate, onset_data, window_size=4096):\n",
    "    \"\"\"\n",
    "    Compute and display FFT for each detected note\n",
    "    \"\"\"\n",
    "    note_ffts = []\n",
    "    \n",
    "    for i, (start_time, end_time) in enumerate(zip(onset_data['note_start_times'], onset_data['note_end_times'])):\n",
    "        # Convert time to sample indices\n",
    "        start_sample = int(start_time * sample_rate)\n",
    "        end_sample = int(end_time * sample_rate)\n",
    "        \n",
    "        # Extract note segment\n",
    "        note_segment = audio_signal[start_sample:end_sample]\n",
    "        \n",
    "        if len(note_segment) < 512:  # Too short for analysis\n",
    "            continue\n",
    "        \n",
    "        # Pad or truncate to window_size for consistent analysis\n",
    "        if len(note_segment) > window_size:\n",
    "            # Take middle portion\n",
    "            mid_point = len(note_segment) // 2\n",
    "            start_idx = mid_point - window_size // 2\n",
    "            end_idx = mid_point + window_size // 2\n",
    "            note_segment = note_segment[start_idx:end_idx]\n",
    "        else:\n",
    "            # Zero-pad if too short\n",
    "            note_segment = np.pad(note_segment, (0, window_size - len(note_segment)), 'constant')\n",
    "        \n",
    "        # Apply windowing\n",
    "        windowed_segment = note_segment * np.hanning(len(note_segment))\n",
    "        \n",
    "        # Compute FFT\n",
    "        fft_result = np.fft.fft(windowed_segment)\n",
    "        frequencies = np.fft.fftfreq(len(fft_result), d=1/sample_rate)\n",
    "        magnitude = np.abs(fft_result)\n",
    "        phase = np.angle(fft_result)\n",
    "        \n",
    "        # Store results\n",
    "        note_fft_data = {\n",
    "            'note_number': i + 1,\n",
    "            'start_time': start_time,\n",
    "            'end_time': end_time,\n",
    "            'duration': end_time - start_time,\n",
    "            'frequencies': frequencies,\n",
    "            'magnitude': magnitude,\n",
    "            'phase': phase,\n",
    "            'note_segment': note_segment,\n",
    "            'windowed_segment': windowed_segment\n",
    "        }\n",
    "        \n",
    "        note_ffts.append(note_fft_data)\n",
    "    \n",
    "    return note_ffts\n",
    "\n",
    "# Analyze FFT for each note using original audio\n",
    "note_fft_analysis = analyze_note_fft(audio_signal, sample_rate, onset_data_original)\n",
    "\n",
    "# Display FFT results\n",
    "print(\"FFT Analysis of Each Detected Note:\")\n",
    "print(\"=\" * 60)\n",
    "\n",
    "for note_data in note_fft_analysis:\n",
    "    print(f\"\\nNote {note_data['note_number']}:\")\n",
    "    print(f\"  Time: {note_data['start_time']:.2f}s - {note_data['end_time']:.2f}s\")\n",
    "    print(f\"  Duration: {note_data['duration']:.3f}s\")\n",
    "    \n",
    "    # Find dominant frequencies (top 5 peaks)\n",
    "    positive_freqs = note_data['frequencies'][:len(note_data['frequencies'])//2]\n",
    "    positive_magnitude = note_data['magnitude'][:len(note_data['magnitude'])//2]\n",
    "    \n",
    "    # Filter to musical range\n",
    "    freq_mask = (positive_freqs >= 80) & (positive_freqs <= 2000)\n",
    "    filtered_freqs = positive_freqs[freq_mask]\n",
    "    filtered_magnitude = positive_magnitude[freq_mask]\n",
    "    \n",
    "    if len(filtered_magnitude) > 0:\n",
    "        # Find top 5 peaks\n",
    "        peak_indices = np.argsort(filtered_magnitude)[-5:][::-1]\n",
    "        print(\"  Top 5 frequency components:\")\n",
    "        for j, peak_idx in enumerate(peak_indices):\n",
    "            freq = filtered_freqs[peak_idx]\n",
    "            mag = filtered_magnitude[peak_idx]\n",
    "            print(f\"    {j+1}. {freq:.1f} Hz (magnitude: {mag:.1f})\")\n",
    "\n",
    "# Visualize FFT of each note\n",
    "num_notes = len(note_fft_analysis)\n",
    "if num_notes > 0:\n",
    "    # Create subplot grid\n",
    "    cols = min(3, num_notes)\n",
    "    rows = (num_notes + cols - 1) // cols\n",
    "    \n",
    "    plt.figure(figsize=(15, 4*rows))\n",
    "    \n",
    "    for i, note_data in enumerate(note_fft_analysis):\n",
    "        plt.subplot(rows, cols, i+1)\n",
    "        \n",
    "        # Plot magnitude spectrum (positive frequencies only)\n",
    "        positive_freqs = note_data['frequencies'][:len(note_data['frequencies'])//2]\n",
    "        positive_magnitude = note_data['magnitude'][:len(note_data['magnitude'])//2]\n",
    "        \n",
    "        plt.plot(positive_freqs, positive_magnitude, 'b-', alpha=0.7)\n",
    "        plt.title(f\"Note {note_data['note_number']} FFT\\n({note_data['start_time']:.2f}s - {note_data['end_time']:.2f}s)\")\n",
    "        plt.xlabel(\"Frequency (Hz)\")\n",
    "        plt.ylabel(\"Magnitude\")\n",
    "        plt.xlim(0, 2000)  # Focus on musical frequency range\n",
    "        plt.grid(True, alpha=0.3)\n",
    "        \n",
    "        # Mark the fundamental frequency if available\n",
    "        if i < len(note_freq_data_original):\n",
    "            fundamental = note_freq_data_original[i]['detected_frequency']\n",
    "            plt.axvline(x=fundamental, color='red', linestyle='--', alpha=0.8, \n",
    "                       label=f'Fundamental: {fundamental:.1f}Hz')\n",
    "            plt.legend(fontsize=8)\n",
    "    \n",
    "    plt.tight_layout()\n",
    "    plt.show()\n",
    "\n",
    "# Show detailed spectrograms for first few notes\n",
    "if len(note_fft_analysis) >= 3:\n",
    "    fig, axes = plt.subplots(3, 1, figsize=(15, 12))\n",
    "    \n",
    "    for i in range(min(3, len(note_fft_analysis))):\n",
    "        note_data = note_fft_analysis[i]\n",
    "        \n",
    "        # Create spectrogram of the note segment\n",
    "        f, t, Sxx = sig.spectrogram(note_data['note_segment'], sample_rate, \n",
    "                                   nperseg=512, noverlap=256)\n",
    "        \n",
    "        im = axes[i].pcolormesh(t, f, 10 * np.log10(Sxx + 1e-10), shading='gouraud')\n",
    "        axes[i].set_ylabel('Frequency (Hz)')\n",
    "        axes[i].set_ylim(0, 2000)\n",
    "        axes[i].set_title(f'Spectrogram - Note {note_data[\"note_number\"]} '\n",
    "                         f'({note_data[\"start_time\"]:.2f}s - {note_data[\"end_time\"]:.2f}s)')\n",
    "        axes[i].grid(True, alpha=0.3)\n",
    "        \n",
    "        # Add colorbar\n",
    "        plt.colorbar(im, ax=axes[i], label='Power (dB)')\n",
    "    \n",
