    "def detect_notes_with_envelope_analysis(audio_signal, sample_rate, hop_length=512):\n",
    "    \"\"\"\n",
    "    Enhanced note detection using envelope analysis and improved segmentation for longer notes.\n",
    "    Spectral centroid onsets are only accepted if RMS also rises (to avoid false splits).\n",
    "    \"\"\"\n",
    "    import scipy.signal as sig\n",
    "    from scipy.ndimage import gaussian_filter1d\n",
    "\n",
    "    frame_length = 2048\n",
    "    rms = librosa.feature.rms(y=audio_signal, frame_length=frame_length, hop_length=hop_length)[0]\n",
    "    spectral_centroid = librosa.feature.spectral_centroid(y=audio_signal, sr=sample_rate, hop_length=hop_length)[0]\n",
    "    times = librosa.frames_to_time(np.arange(len(rms)), sr=sample_rate, hop_length=hop_length)\n",
    "    rms_smooth = gaussian_filter1d(rms, sigma=3)\n",
    "    centroid_smooth = gaussian_filter1d(spectral_centroid, sigma=3)\n",
    "\n",
    "    # Onset detection: spectral flux (librosa) and RMS only\n",
    "    onset_frames_spectral = librosa.onset.onset_detect(\n",
    "        y=audio_signal,\n",
    "        sr=sample_rate,\n",
    "        hop_length=hop_length,\n",
    "        units='frames',\n",
    "        pre_max=30,\n",
    "        post_max=30,\n",
    "        pre_avg=150,\n",
    "        post_avg=150,\n",
    "        delta=0.05,\n",
    "        wait=20\n",
    "    )\n",
    "    rms_diff = np.diff(rms_smooth)\n",
    "    rms_onset_threshold = np.std(rms_diff) * 1.0\n",
    "    rms_onsets = sig.find_peaks(rms_diff, height=rms_onset_threshold, distance=int(0.1 * sample_rate / hop_length))[0]\n",
    "\n",
    "    # Spectral centroid onsets: only keep if RMS rises at the same frame\n",
    "    centroid_diff = np.abs(np.diff(centroid_smooth))\n",
    "    centroid_threshold = np.percentile(centroid_diff, 90)  # Make much less sensitive\n",
    "    centroid_onsets = sig.find_peaks(centroid_diff, height=centroid_threshold, distance=int(0.2 * sample_rate / hop_length))[0]\n",
    "\n",
    "    # Only keep centroid onsets where RMS also rises (within ±1 frame)\n",
    "    valid_centroid_onsets = []\n",
    "    for c in centroid_onsets:\n",
    "        if c < len(rms_diff) and rms_diff[c] > rms_onset_threshold * 0.5:\n",
    "            valid_centroid_onsets.append(c)\n",
    "    valid_centroid_onsets = np.array(valid_centroid_onsets)\n",
    "\n",
    "    # Combine onsets (spectral flux, RMS, and only valid centroid onsets)\n",
    "    all_onsets = np.unique(np.concatenate([onset_frames_spectral, rms_onsets, valid_centroid_onsets]))\n",
    "    onset_times = librosa.frames_to_time(all_onsets, sr=sample_rate, hop_length=hop_length)\n",
    "\n",
    "    # ...rest of your note segmentation code unchanged...\n",
    "    notes = []\n",
    "    min_note_duration = 0.08\n",
    "    max_note_duration = 8.0\n",
    "    rms_threshold_base = np.percentile(rms_smooth, 10)\n",
    "    min_rms_for_end = np.max(rms_smooth) * 0.05\n",
    "\n",
    "    for i, onset_time in enumerate(onset_times):\n",
    "        onset_frame = all_onsets[i]\n",
    "        if i < len(onset_times) - 1:\n",
    "            next_onset_frame = all_onsets[i + 1]\n",
    "            max_search_frame = min(next_onset_frame, onset_frame + int(max_note_duration * sample_rate / hop_length))\n",
    "        else:\n",
    "            max_search_frame = min(len(rms_smooth) - 1, onset_frame + int(max_note_duration * sample_rate / hop_length))\n",
    "\n",
    "        search_start = onset_frame\n",
    "        search_end = max_search_frame\n",
    "        end_frame = search_end - 1\n",
    "        segment_rms = rms_smooth[search_start:search_end]\n",
    "        if len(segment_rms) == 0:\n",
    "            continue\n",
    "\n",
    "        below_min_rms = np.where(segment_rms < min_rms_for_end)[0]\n",
    "        if len(below_min_rms) > 0:\n",
    "            min_sustain_frames = max(1, int(0.05 * sample_rate / hop_length))\n",
    "            for idx in below_min_rms:\n",
    "                end_idx = idx + min_sustain_frames\n",
    "                if end_idx < len(segment_rms) and np.all(segment_rms[idx:end_idx] < min_rms_for_end):\n",
    "                    end_frame = search_start + idx\n",
    "                    break\n",
    "\n",
    "        start_time = onset_time\n",
    "        end_time = times[min(end_frame, len(times) - 1)]\n",
    "        duration = end_time - start_time\n",
    "\n",
    "        if duration >= min_note_duration and duration <= max_note_duration:\n",
    "            start_sample = int(start_time * sample_rate)\n",
    "            end_sample = int(end_time * sample_rate)\n",
    "            note_rms = np.mean(rms_smooth[onset_frame:min(end_frame, len(rms_smooth))])\n",
    "            note_info = {\n",
    "                'start_time': start_time,\n",
    "                'end_time': end_time,\n",
    "                'duration': duration,\n",
    "                'onset_frame': onset_frame,\n",
    "                'end_frame': end_frame,\n",
    "                'start_sample': start_sample,\n",
    "                'end_sample': end_sample,\n",
    "                'avg_rms': note_rms\n",
    "            }\n",
    "            notes.append(note_info)\n",
    "\n",
    "    notes = remove_overlapping_notes_conservative(notes)\n",
    "    return {\n",
    "        'notes': notes,\n",
    "        'rms': rms_smooth,\n",
    "        'spectral_centroid': centroid_smooth,\n",
    "        'times': times,\n",
    "        'onset_times': onset_times,\n",
    "        'rms_threshold': rms_threshold_base\n",
    "    }\n",
    "\n",
    "def remove_overlapping_notes_conservative(notes):\n",
    "    \"\"\"Very conservative overlap removal that strongly preserves longer notes\"\"\"\n",
    "    if len(notes) <= 1:\n",
    "        return notes\n",
    "\n",
    "    notes_sorted = sorted(notes, key=lambda x: x['start_time'])\n",
    "    cleaned_notes = []\n",
    "    current_note = notes_sorted[0]\n",
    "\n",
    "    for next_note in notes_sorted[1:]:\n",
    "        if next_note['start_time'] < current_note['end_time']:\n",
    "            overlap_duration = current_note['end_time'] - next_note['start_time']\n",
    "            if overlap_duration < min(current_note['duration'], next_note['duration']) * 0.2:\n",
    "                boundary_time = current_note['end_time'] - overlap_duration * 0.3\n",
    "                current_note['end_time'] = boundary_time\n",
    "                current_note['duration'] = current_note['end_time'] - current_note['start_time']\n",
    "                if current_note['duration'] > 0.05:\n",
    "                    cleaned_notes.append(current_note)\n",
    "                next_note['start_time'] = boundary_time\n",
    "                next_note['duration'] = next_note['end_time'] - next_note['start_time']\n",
    "                current_note = next_note\n",
    "            else:\n",
    "                duration_ratio = current_note['duration'] / next_note['duration']\n",
    "                rms_ratio = current_note['avg_rms'] / next_note['avg_rms'] if next_note['avg_rms'] > 0 else 1\n",
    "                if duration_ratio > 0.7 or (duration_ratio > 0.4 and rms_ratio > 0.8):\n",
    "                    continue\n",
    "                else:\n",
    "                    if current_note['duration'] > 0.05:\n",
    "                        cleaned_notes.append(current_note)\n",
    "                    current_note = next_note\n",
    "        else:\n",
    "            cleaned_notes.append(current_note)\n",
    "            current_note = next_note\n",
    "\n",
    "    if current_note['duration'] > 0.05:\n",
    "        cleaned_notes.append(current_note)\n",
    "\n",
    "    return cleaned_notes\n",
    "\n",
    "def detect_fundamental_frequency_improved(audio_signal, sample_rate, start_sample, end_sample):\n",
    "    \"\"\"\n",
    "    Improved fundamental frequency detection for longer notes with better stability and octave error check.\n",
    "    \"\"\"\n",
    "    note_segment = audio_signal[start_sample:end_sample]\n",
    "    if len(note_segment) < 512:\n",
    "        return 0\n",
    "\n",
    "    segment_length = len(note_segment)\n",
    "    notes_arr = notes  # Use global notes array\n",
    "\n",
    "    if segment_length > 4096:\n",
    "        num_windows = min(7, segment_length // 2048)\n",
    "        window_size = 2048\n",
    "        frequencies = []\n",
    "\n",
    "        stable_start = int(0.2 * segment_length)\n",
    "        stable_end = int(0.8 * segment_length)\n",
    "        stable_segment = note_segment[stable_start:stable_end]\n",
    "\n",
    "        for i in range(num_windows):\n",
    "            if len(stable_segment) > window_size:\n",
    "                start_idx = i * (len(stable_segment) - window_size) // (num_windows - 1) if num_windows > 1 else 0\n",
    "                end_idx = start_idx + window_size\n",
    "                if end_idx > len(stable_segment):\n",
    "                    end_idx = len(stable_segment)\n",
    "                    start_idx = max(0, end_idx - window_size)\n",
    "                window_segment = stable_segment[start_idx:end_idx]\n",
    "            else:\n",
    "                window_segment = stable_segment\n",
    "\n",
    "            freq = autocorr_pitch_robust(window_segment, sample_rate)\n",
    "            if freq > 0:\n",
    "                frequencies.append(freq)\n",
    "\n",
    "        if len(frequencies) >= 3:\n",
    "            frequencies = np.array(frequencies)\n",
    "            median_freq = np.median(frequencies)\n",
    "            good_freqs = frequencies[np.abs(frequencies - median_freq) / median_freq < 0.03]  # Tighter\n",
    "            freq = np.median(good_freqs) if len(good_freqs) > 0 else median_freq\n",
    "            # Harmonic check: if freq is close to 2x or 0.5x a note, pick the closer one\n",
    "            for factor in [2, 0.5]:\n",
    "                alt = freq * factor\n",
    "                if np.min(np.abs(notes_arr - alt)) < np.min(np.abs(notes_arr - freq)):\n",
    "                    freq = alt\n",
    "            return freq\n",
    "        elif len(frequencies) > 0:\n",
    "            return np.median(frequencies)\n",
    "        else:\n",
    "            mid_start = segment_length // 3\n",
    "            mid_end = 2 * segment_length // 3\n",
    "            return autocorr_pitch_robust(note_segment[mid_start:mid_end], sample_rate)\n",
    "    else:\n",
    "        if segment_length > 1024:\n",
    "            mid_start = segment_length // 4\n",
    "            mid_end = 3 * segment_length // 4\n",
    "            return autocorr_pitch_robust(note_segment[mid_start:mid_end], sample_rate)\n",
    "        else:\n",
    "            return autocorr_pitch_robust(note_segment, sample_rate)\n",
    "\n",
    "def autocorr_pitch_robust(signal, sr, min_freq=65, max_freq=1000):\n",
    "    \"\"\"Robust autocorrelation-based pitch detection with better peak selection\"\"\"\n",
    "    if len(signal) < 512:\n",
    "        return 0\n",
    "\n",
    "    signal = signal - np.mean(signal)\n",
    "    if np.std(signal) > 0:\n",
    "        signal = signal / np.std(signal)\n",
    "\n",
    "    windowed = signal * np.hanning(len(signal))\n",
    "    autocorr = np.correlate(windowed, windowed, mode='full')\n",
    "    autocorr = autocorr[len(autocorr)//2:]\n",
    "\n",
    "    min_period = int(sr / max_freq)\n",
    "    max_period = int(sr / min_freq)\n",
    "\n",
    "    if max_period < len(autocorr) and min_period < max_period:\n",
    "        search_range = autocorr[min_period:min(max_period, len(autocorr))]\n",
    "        if len(search_range) > 0:\n",
    "            peaks, properties = sig.find_peaks(\n",
    "                search_range,\n",
    "                height=np.max(search_range) * 0.3,\n",
    "                prominence=np.max(search_range) * 0.1\n",
    "            )\n",
    "            if len(peaks) > 0:\n",
    "                best_peak_idx = peaks[np.argmax(search_range[peaks])]\n",
    "                peak_idx = best_peak_idx + min_period\n",
    "                detected_freq = sr / peak_idx\n",
    "                if min_freq <= detected_freq <= max_freq:\n",
    "                    return detected_freq\n",
    "    return 0\n",
    "\n",
    "# Apply the conservative note detection algorithm\n",
    "print(\"Applying very conservative note detection algorithm for sustained notes...\")\n",
    "enhanced_note_data = detect_notes_with_envelope_analysis(audio_signal, sample_rate)\n",
    "\n",
    "# Detect frequencies for each note\n",
    "note_results = []\n",
    "note_names = ['C', 'C#', 'D', 'D#', 'E', 'F', 'F#', 'G', 'G#', 'A', 'A#', 'B']\n",
    "\n",
    "for i, note in enumerate(enhanced_note_data['notes']):\n",
    "    fundamental_freq = detect_fundamental_frequency_improved(\n",
    "        audio_signal, sample_rate, note['start_sample'], note['end_sample']\n",
    "    )\n",
    "    if fundamental_freq > 0:\n",
    "        note_idx = np.argmin(np.abs(notes - fundamental_freq))\n",
    "        closest_note_freq = notes[note_idx]\n",
    "        key_num = keys[note_idx]\n",
    "        midi_num = key_num + 20\n",
    "        octave = (midi_num // 12) - 1\n",
