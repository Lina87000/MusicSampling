    "        cent_deviation = 1200 * np.log2(fundamental_freq / closest_note_freq) if closest_note_freq > 0 else 0\n",
    "\n",
    "        note_info = {\n",
    "            'note_number': i + 1,\n",
    "            'start_time': note['start_time'],\n",
    "            'end_time': note['end_time'],\n",
    "            'duration': note['duration'],\n",
    "            'detected_frequency': fundamental_freq,\n",
    "            'closest_note_frequency': closest_note_freq,\n",
    "            'note_name': f\"{note_name}{octave}\",\n",
    "            'note_only': note_name,\n",
    "            'key_number': key_num,\n",
    "            'midi_number': midi_num,\n",
    "            'cent_deviation': cent_deviation\n",
    "        }\n",
    "        note_results.append(note_info)\n",
    "\n",
    "# Display results\n",
    "print(\"\\nVery Conservative Note Detection Results (Optimized for Sustained Notes):\")\n",
    "print(\"=\" * 80)\n",
    "print(f\"{'Note#':<5} {'Time':<12} {'Duration':<8} {'Freq (Hz)':<10} {'Note':<8} {'Closest':<10} {'Cents':<8}\")\n",
    "print(\"-\" * 80)\n",
    "\n",
    "for note in note_results:\n",
    "    print(f\"{note['note_number']:<5} \"\n",
    "          f\"{note['start_time']:.2f}-{note['end_time']:.2f}  \"\n",
