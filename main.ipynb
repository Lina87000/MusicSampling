    "          f\"{note['cent_deviation']:+.0f}\")\n",
    "\n",
    "# Visualization\n",
    "plt.figure(figsize=(15, 12))\n",
    "\n",
    "# Plot 1: Audio signal with detected notes\n",
    "plt.subplot(4, 1, 1)\n",
