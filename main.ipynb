    "# Note onset and duration detection\n",
    "def detect_note_onsets_and_durations(audio_signal, sample_rate, hop_length=512):\n",
    "    \"\"\"\n",
    "    Detect note onsets and calculate their durations\n",
    "    \"\"\"\n",
    "    # Calculate onset strength using spectral flux\n",
    "    onset_frames = librosa.onset.onset_detect(\n",
    "        y=audio_signal, \n",
    "        sr=sample_rate, \n",
    "        hop_length=hop_length,\n",
    "        units='frames'\n",
    "    )\n",
    "    \n",
    "    # Convert frames to time\n",
    "    onset_times = librosa.frames_to_time(onset_frames, sr=sample_rate, hop_length=hop_length)\n",
    "    \n",
    "    # Calculate envelope using RMS energy\n",
    "    frame_length = 2048\n",
    "    rms = librosa.feature.rms(y=audio_signal, frame_length=frame_length, hop_length=hop_length)[0]\n",
    "    \n",
    "    # Time axis for RMS\n",
    "    rms_times = librosa.frames_to_time(np.arange(len(rms)), sr=sample_rate, hop_length=hop_length)\n",
    "    \n",
    "    # Detect note end points using envelope threshold\n",
    "    rms_threshold = np.max(rms) * 0.1  # 10% of max amplitude\n",
    "    above_threshold = rms > rms_threshold\n",
    "    \n",
    "    # Find note durations\n",
    "    note_durations = []\n",
    "    note_start_times = []\n",
    "    note_end_times = []\n",
    "    \n",
    "    for onset_time in onset_times:\n",
    "        # Find the closest RMS frame to onset\n",
    "        onset_idx = np.argmin(np.abs(rms_times - onset_time))\n",
    "        \n",
    "        # Look forward to find when amplitude drops below threshold\n",
    "        end_idx = onset_idx\n",
    "        while end_idx < len(above_threshold) - 1 and above_threshold[end_idx]:\n",
    "            end_idx += 1\n",
    "        \n",
    "        # Calculate duration\n",
    "        start_time = onset_time\n",
    "        end_time = rms_times[min(end_idx, len(rms_times) - 1)]\n",
    "        duration = end_time - start_time\n",
    "        \n",
    "        note_start_times.append(start_time)\n",
    "        note_end_times.append(end_time)\n",
    "        note_durations.append(duration)\n",
    "    \n",
    "    return {\n",
    "        'onset_times': onset_times,\n",
    "        'note_durations': note_durations,\n",
    "        'note_start_times': note_start_times,\n",
    "        'note_end_times': note_end_times,\n",
    "        'rms': rms,\n",
    "        'rms_times': rms_times,\n",
    "        'rms_threshold': rms_threshold\n",
    "    }\n",
    "\n",
    "# Apply onset and duration detection\n",
    "onset_data = detect_note_onsets_and_durations(filtered_signal, sample_rate)\n",
    "\n",
    "# Visualize results\n",
    "plt.figure(figsize=(15, 10))\n",
    "\n",
    "# Plot 1: Audio signal with onsets\n",
    "plt.subplot(3, 1, 1)\n",
    "plt.plot(time, filtered_signal, label=\"Audio Signal\", alpha=0.7)\n",
    "for onset_time in onset_data['onset_times']:\n",
    "    plt.axvline(x=onset_time, color='red', linestyle='--', alpha=0.8, label='Onset' if onset_time == onset_data['onset_times'][0] else \"\")\n",
    "plt.title(\"Audio Signal with Detected Onsets\")\n",
    "plt.xlabel(\"Time (s)\")\n",
    "plt.ylabel(\"Amplitude\")\n",
    "plt.legend()\n",
    "plt.grid()\n",
    "\n",
    "# Plot 2: RMS envelope with threshold\n",
    "plt.subplot(3, 1, 2)\n",
    "plt.plot(onset_data['rms_times'], onset_data['rms'], label=\"RMS Envelope\", color='blue')\n",
    "plt.axhline(y=onset_data['rms_threshold'], color='green', linestyle=':', label=f\"Threshold ({onset_data['rms_threshold']:.4f})\")\n",
    "for i, (start, end) in enumerate(zip(onset_data['note_start_times'], onset_data['note_end_times'])):\n",
    "    plt.axvspan(start, end, alpha=0.3, color=f'C{i%10}', label=f'Note {i+1}' if i < 5 else \"\")\n",
    "plt.title(\"RMS Envelope with Note Durations\")\n",
    "plt.xlabel(\"Time (s)\")\n",
    "plt.ylabel(\"RMS Energy\")\n",
    "plt.legend()\n",
    "plt.grid()\n",
    "\n",
    "# Plot 3: Note duration visualization\n",
    "plt.subplot(3, 1, 3)\n",
    "for i, (start, duration) in enumerate(zip(onset_data['note_start_times'], onset_data['note_durations'])):\n",
    "    plt.barh(i, duration, left=start, height=0.8, alpha=0.7, label=f'Note {i+1}: {duration:.3f}s')\n",
    "plt.title(\"Note Durations Timeline\")\n",
    "plt.xlabel(\"Time (s)\")\n",
    "plt.ylabel(\"Note Number\")\n",
    "plt.grid()\n",
    "\n",
    "plt.tight_layout()\n",
    "plt.show()\n",
    "\n",
    "# Print results\n",
    "print(\"Detected Notes Summary:\")\n",
    "print(\"-\" * 50)\n",
    "for i, (onset, duration, start, end) in enumerate(zip(\n",
    "    onset_data['onset_times'], \n",
    "    onset_data['note_durations'],\n",
    "    onset_data['note_start_times'],\n",
    "    onset_data['note_end_times']\n",
    ")):\n",
    "    print(f\"Note {i+1}:\")\n",
    "    print(f\"  Onset: {onset:.3f}s\")\n",
    "    print(f\"  Duration: {duration:.3f}s\")\n",
    "    print(f\"  Start: {start:.3f}s\")\n",
    "    print(f\"  End: {end:.3f}s\")\n",
    "    print()\n",
    "\n",
    "print(f\"Total notes detected: {len(onset_data['onset_times'])}\")"
   ]
  },
