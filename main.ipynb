    "def detect_note_frequencies_improved(audio_signal, sample_rate, onset_data, window_size=4096):\n",
    "    \"\"\"\n",
    "    Improved note frequency detection using the original audio signal\n",
    "    \"\"\"\n",
    "    note_frequencies = []\n",
    "    note_names = ['C', 'C#', 'D', 'D#', 'E', 'F', 'F#', 'G', 'G#', 'A', 'A#', 'B']\n",
    "    \n",
    "    for i, (start_time, end_time) in enumerate(zip(onset_data['note_start_times'], onset_data['note_end_times'])):\n",
    "        # Convert time to sample indices\n",
    "        start_sample = int(start_time * sample_rate)\n",
    "        end_sample = int(end_time * sample_rate)\n",
    "        \n",
    "        # Take a segment from the middle of the note for better frequency detection\n",
    "        segment_length = end_sample - start_sample\n",
    "        if segment_length > window_size:\n",
    "            # Take from the middle portion of the note\n",
    "            mid_point = (start_sample + end_sample) // 2\n",
    "            start_analysis = mid_point - window_size // 2\n",
    "            end_analysis = mid_point + window_size // 2\n",
    "        else:\n",
    "            start_analysis = start_sample\n",
    "            end_analysis = end_sample\n",
    "        \n",
    "        note_segment = audio_signal[start_analysis:end_analysis]  # Use original audio_signal\n",
    "        \n",
    "        if len(note_segment) < 512:  # Too short for analysis\n",
    "            continue\n",
    "            \n",
    "        # Apply windowing to reduce spectral leakage\n",
    "        windowed_segment = note_segment * np.hanning(len(note_segment))\n",
    "        \n",
    "        # FFT-based frequency detection\n",
    "        fft_segment = np.fft.fft(windowed_segment)\n",
    "        freqs_segment = np.fft.fftfreq(len(fft_segment), d=1/sample_rate)\n",
    "        magnitude_segment = np.abs(fft_segment)\n",
    "        \n",
    "        # Focus on musical frequency range (80Hz to 1000Hz for better fundamental detection)\n",
    "        freq_mask = (freqs_segment >= 80) & (freqs_segment <= 1000)\n",
    "        masked_freqs = freqs_segment[freq_mask]\n",
    "        masked_magnitudes = magnitude_segment[freq_mask]\n",
    "        \n",
    "        if len(masked_magnitudes) > 0:\n",
    "            peak_idx = np.argmax(masked_magnitudes)\n",
    "            detected_freq = masked_freqs[peak_idx]\n",
    "        else:\n",
    "            detected_freq = 0\n",
    "        \n",
    "        # Improved autocorrelation for fundamental frequency\n",
    "        def autocorr_fundamental_improved(signal, sr):\n",
    "            # Normalize signal\n",
    "            signal = signal - np.mean(signal)\n",
    "            if np.std(signal) > 0:\n",
    "                signal = signal / np.std(signal)\n",
    "            \n",
    "            # Calculate autocorrelation\n",
    "            autocorr = np.correlate(signal, signal, mode='full')\n",
    "            autocorr = autocorr[len(autocorr)//2:]\n",
    "            \n",
    "            # Define frequency range for musical notes (C2 to C6: ~65Hz to 1047Hz)\n",
    "            min_freq, max_freq = 65, 1047\n",
    "            min_period = int(sr / max_freq)\n",
    "            max_period = int(sr / min_freq)\n",
    "            \n",
    "            if max_period < len(autocorr) and min_period < max_period:\n",
    "                # Look for peaks in the autocorrelation\n",
    "                search_range = autocorr[min_period:min(max_period, len(autocorr))]\n",
    "                if len(search_range) > 0:\n",
    "                    # Find the most prominent peak\n",
    "                    peak_idx = np.argmax(search_range) + min_period\n",
    "                    fundamental_freq = sr / peak_idx\n",
    "                    return fundamental_freq\n",
    "            return detected_freq\n",
    "        \n",
    "        # Use autocorrelation for better fundamental detection\n",
    "        fundamental_freq = autocorr_fundamental_improved(note_segment, sample_rate)\n",
    "        \n",
    "        # If autocorrelation gives unrealistic result, use FFT result\n",
    "        if fundamental_freq < 65 or fundamental_freq > 1047:\n",
    "            fundamental_freq = detected_freq\n",
    "        \n",
    "        # Find closest musical note\n",
    "        if fundamental_freq > 0:\n",
    "            note_idx = np.argmin(np.abs(notes - fundamental_freq))\n",
    "            closest_note_freq = notes[note_idx]\n",
    "            key_num = keys[note_idx]\n",
    "            \n",
    "            # Calculate MIDI note and octave\n",
    "            midi_num = key_num + 20\n",
    "            octave = (midi_num // 12) - 1\n",
    "            note_name = note_names[midi_num % 12]\n",
    "            \n",
    "            # Calculate cent deviation\n",
    "            cent_deviation = 1200 * np.log2(fundamental_freq / closest_note_freq) if closest_note_freq > 0 else 0\n",
    "            \n",
    "            note_info = {\n",
    "                'note_number': i + 1,\n",
    "                'start_time': start_time,\n",
    "                'end_time': end_time,\n",
    "                'duration': end_time - start_time,\n",
    "                'detected_frequency': fundamental_freq,\n",
    "                'closest_note_frequency': closest_note_freq,\n",
    "                'note_name': f\"{note_name}{octave}\",\n",
    "                'note_only': note_name,\n",
    "                'key_number': key_num,\n",
    "                'midi_number': midi_num,\n",
    "                'cent_deviation': cent_deviation,\n",
    "                'fft_freq': detected_freq\n",
    "            }\n",
    "            \n",
    "            note_frequencies.append(note_info)\n",
    "    \n",
    "    return note_frequencies\n",
    "\n",
    "# Re-detect onsets using original audio signal\n",
    "onset_data_original = detect_note_onsets_and_durations(audio_signal, sample_rate)\n",
    "\n",
    "# Apply improved frequency detection using original audio\n",
    "note_freq_data_original = detect_note_frequencies_improved(audio_signal, sample_rate, onset_data_original)\n",
    "\n",
    "# Display results\n",
    "print(\"Note Detection Using Original Audio Signal:\")\n",
    "print(\"=\" * 80)\n",
    "print(f\"{'Note#':<5} {'Time':<12} {'Duration':<8} {'Freq (Hz)':<10} {'Note':<8} {'Closest':<10} {'Cents':<8}\")\n",
    "print(\"-\" * 80)\n",
    "\n",
    "for note in note_freq_data_original:\n",
    "    print(f\"{note['note_number']:<5} \"\n",
    "          f\"{note['start_time']:.2f}-{note['end_time']:.2f}  \"\n",
    "          f\"{note['duration']:.2f}s   \"\n",
    "          f\"{note['detected_frequency']:.1f}     \"\n",
    "          f\"{note['note_name']:<8} \"\n",
    "          f\"{note['closest_note_frequency']:.1f}Hz   \"\n",
    "          f\"{note['cent_deviation']:+.0f}\")\n",
    "\n",
    "# Extract just the note names for comparison\n",
    "detected_notes = [note['note_only'] for note in note_freq_data_original]\n",
    "expected_notes = ['C', 'C', 'C', 'D', 'E', 'D', 'C', 'E', 'D', 'D', 'C']\n",
    "\n",
    "print(f\"\\nDetected sequence: {' '.join(detected_notes)}\")\n",
    "print(f\"Expected sequence: {' '.join(expected_notes)}\")\n",
    "\n",
    "# Calculate accuracy\n",
    "if len(detected_notes) == len(expected_notes):\n",
    "    matches = sum(1 for d, e in zip(detected_notes, expected_notes) if d == e)\n",
    "    accuracy = matches / len(expected_notes) * 100\n",
    "    print(f\"Accuracy: {matches}/{len(expected_notes)} ({accuracy:.1f}%)\")\n",
    "else:\n",
    "    print(f\"Length mismatch: detected {len(detected_notes)} notes, expected {len(expected_notes)}\")\n",
    "\n",
    "# Visualize the comparison\n",
    "plt.figure(figsize=(15, 8))\n",
    "\n",
    "# Plot 1: Original audio with detected notes\n",
    "plt.subplot(2, 1, 1)\n",
    "plt.plot(time, audio_signal, alpha=0.5, color='gray', label='Original Audio')\n",
    "for i, note in enumerate(note_freq_data_original):\n",
    "    plt.axvspan(note['start_time'], note['end_time'], alpha=0.3, color=f'C{i%10}')\n",
    "    plt.text(note['start_time'] + note['duration']/2, np.max(audio_signal)*0.8, \n",
    "             note['note_only'], ha='center', va='center', fontsize=10, fontweight='bold')\n",
    "\n",
    "plt.title(\"Original Audio Signal with Detected Notes\")\n",
    "plt.xlabel(\"Time (s)\")\n",
    "plt.ylabel(\"Amplitude\")\n",
    "plt.legend()\n",
    "plt.grid()\n",
    "\n",
    "# Plot 2: Note comparison\n",
    "plt.subplot(2, 1, 2)\n",
    "x_pos = np.arange(max(len(detected_notes), len(expected_notes)))\n",
    "\n",
    "if len(detected_notes) <= len(expected_notes):\n",
    "    detected_padded = detected_notes + [''] * (len(expected_notes) - len(detected_notes))\n",
    "    expected_padded = expected_notes\n",
    "else:\n",
    "    detected_padded = detected_notes\n",
    "    expected_padded = expected_notes + [''] * (len(detected_notes) - len(expected_notes))\n",
    "\n",
    "# Plot detected notes\n",
    "plt.bar(x_pos - 0.2, [1]*len(x_pos), width=0.4, alpha=0.7, color='lightblue', label='Detected')\n",
    "for i, note_name in enumerate(detected_padded):\n",
    "    if note_name:\n",
    "        plt.text(i - 0.2, 0.5, note_name, ha='center', va='center', fontsize=12, fontweight='bold')\n",
    "\n",
    "# Plot expected notes\n",
    "plt.bar(x_pos + 0.2, [1]*len(x_pos), width=0.4, alpha=0.7, color='lightcoral', label='Expected')\n",
    "for i, note_name in enumerate(expected_padded):\n",
    "    if note_name:\n",
    "        plt.text(i + 0.2, 0.5, note_name, ha='center', va='center', fontsize=12, fontweight='bold')\n",
    "\n",
    "plt.xlabel(\"Note Position\")\n",
    "plt.ylabel(\"Note\")\n",
    "plt.title(\"Detected vs Expected Note Sequence\")\n",
    "plt.xticks(x_pos, [f\"{i+1}\" for i in x_pos])\n",
    "plt.legend()\n",
    "plt.grid(axis='y')\n",
    "plt.tight_layout()\n",
    "plt.show()"
   ]
